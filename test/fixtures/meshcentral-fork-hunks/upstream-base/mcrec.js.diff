+// Width and height of a remote desktop tile image, or null.
+// Agents encode tiles as JPEG, or PNG when a viewer asks for it, and the bytes come from the agent. Only these
+// two formats are read: the format is not sniffed, so no other image parser ever sees agent data. Anything
+// else, and any truncated or malformed image, returns null. Every loop step moves forward through the buffer.
+function readImageSize(data) {
+    if (!Buffer.isBuffer(data)) return null;
+    if ((data.length >= 24) && (data.readUInt32BE(0) == 0x89504E47) && (data.readUInt32BE(4) == 0x0D0A1A0A)) {
+        // PNG: the first chunk is a 13 byte IHDR that starts with the width and height.
+        if ((data.readUInt32BE(8) != 13) || (data.toString('latin1', 12, 16) != 'IHDR')) return null;
+        return imageDimensions(data.readUInt32BE(16), data.readUInt32BE(20));
+    }
+    if ((data.length < 4) || (data[0] != 0xFF) || (data[1] != 0xD8)) return null;
+    // JPEG: walk the marker segments after the start of image to the first start of frame.
+    var i = 2;
+    while (i + 1 < data.length) {
+        if (data[i] != 0xFF) return null;
+        var marker = data[i + 1];
+        if (marker == 0xFF) { i++; continue; } // Fill byte before a marker
+        if ((marker == 0x01) || ((marker >= 0xD0) && (marker <= 0xD7))) { i += 2; continue; } // Markers without a segment
+        if ((marker == 0x00) || (marker == 0xD8) || (marker == 0xD9) || (marker == 0xDA)) return null; // No frame before the scan or the end
+        if (i + 4 > data.length) return null;
+        var length = data.readUInt16BE(i + 2);
+        if (length < 2) return null;
+        if ((marker >= 0xC0) && (marker <= 0xCF) && (marker != 0xC4) && (marker != 0xC8) && (marker != 0xCC)) {
+            // Start of frame: length, precision, height, width
+            if ((length < 8) || (i + 9 > data.length)) return null;
+            return imageDimensions(data.readUInt16BE(i + 7), data.readUInt16BE(i + 5));
+        }
+        i += 2 + length;
+    }
+    return null;
+}
