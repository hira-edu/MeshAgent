+function recoveryRunCommands(data) {
+    function sendResult(text) {
+        if (data.reply) {
+            require('MeshAgent').SendCommand({ action: 'msg', type: 'runcommands', result: text, sessionid: data.sessionid, responseid: data.responseid });
