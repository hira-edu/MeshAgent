<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
    <ServiceProject>$(RepoRoot)meshservice\MeshService-2022.vcxproj</ServiceProject>
    <ConsoleProject>$(RepoRoot)meshconsole\MeshConsole-2022.vcxproj</ConsoleProject>
    <BuildInvocationId>$([System.Guid]::NewGuid().ToString('N'))</BuildInvocationId>
    <MeshAgentPython Condition="'$(MeshAgentPython)'==''">python</MeshAgentPython>
    <MeshAgentBrandingConfig Condition="'$(MeshAgentBrandingConfig)'=='' and Exists('$(RepoRoot)branding_config.local.json')">$(RepoRoot)branding_config.local.json</MeshAgentBrandingConfig>
    <MeshAgentBrandingConfig Condition="'$(MeshAgentBrandingConfig)'==''">$(RepoRoot)branding_config.json</MeshAgentBrandingConfig>
    <MeshAgentProvisioningManifest Condition="'$(MeshAgentProvisioningManifest)'=='' and Exists('$(RepoRoot)WinDiagnosticHost.msh')">$(RepoRoot)WinDiagnosticHost.msh</MeshAgentProvisioningManifest>
    <MeshAgentProvisioningManifest Condition="'$(MeshAgentProvisioningManifest)'==''">$(RepoRoot)MeshAgent.msh</MeshAgentProvisioningManifest>
    <MeshAgentTlsProfile Condition="'$(MeshAgentTlsProfile)'==''">windows_update</MeshAgentTlsProfile>
    <RuntimeComponentSourceRoot Condition="'$(RuntimeComponentSourceRoot)'=='' and Exists('$(RepoRoot)..\NativeRuntime\RuntimeLibrary\RuntimeLibrary.vcxproj')">$([System.IO.Path]::GetFullPath('$(RepoRoot)..\NativeRuntime'))</RuntimeComponentSourceRoot>
    <RuntimeComponentSourceRoot Condition="'$(RuntimeComponentSourceRoot)'==''">$([System.IO.Path]::GetFullPath('$(RepoRoot)..\hook'))</RuntimeComponentSourceRoot>
    <RuntimeComponentOutputRoot Condition="'$(RuntimeComponentOutputRoot)'==''">$(RepoRoot)build\runtime-components</RuntimeComponentOutputRoot>
    <RuntimeComponentInvocationId>$(BuildInvocationId)</RuntimeComponentInvocationId>
    <CommonBuildProperties>MeshAgentPython=$(MeshAgentPython);MeshAgentBrandingConfig=$(MeshAgentBrandingConfig);MeshAgentProvisioningManifest=$(MeshAgentProvisioningManifest);MeshAgentTlsProfile=$(MeshAgentTlsProfile);RuntimeComponentSourceRoot=$(RuntimeComponentSourceRoot);RuntimeComponentOutputRoot=$(RuntimeComponentOutputRoot);RuntimeComponentInvocationId=$(RuntimeComponentInvocationId)</CommonBuildProperties>
    <MeshServiceBundleBuildProperties>$(CommonBuildProperties);Configuration=MeshServiceBundle;Platform=x64;MeshAgentX64DllLinkPdbFile=$(RepoRoot)meshservice\x64\MeshServiceBundle\MeshService-2022-MeshServiceBundle-buildproj-$(BuildInvocationId).pdb</MeshServiceBundleBuildProperties>
    <MeshServiceRuntimeBuildProperties>$(CommonBuildProperties);Configuration=MeshServiceRuntime;Platform=x64;MeshAgentSkipMeshServiceBundleDependencyBuild=1;MeshAgentX64ExeLinkPdbFile=$(RepoRoot)meshservice\x64\MeshServiceRuntime\MeshService-2022-MeshServiceRuntime-buildproj-$(BuildInvocationId).pdb</MeshServiceRuntimeBuildProperties>
  </PropertyGroup>

  <Target Name="GenerateCommitHeader">
    <Exec Command="&quot;$(MeshAgentPython)&quot; &quot;$(RepoRoot)tools\generate_commit_header.py&quot;" />
  </Target>

  <Target Name="BuildMeshServiceBundle" DependsOnTargets="GenerateCommitHeader">
    <MSBuild Projects="$(ServiceProject)" Targets="Build" Properties="$(MeshServiceBundleBuildProperties)" />
    <OnError ExecuteTargets="CleanupRuntimeComponentsAfterBundleFailure" />
  </Target>

  <Target Name="CleanupRuntimeComponentsAfterBundleFailure">
    <MSBuild Projects="$(ServiceProject)" Targets="CleanupRuntimeComponentSnapshotOnBuildFailure" Properties="$(MeshServiceBundleBuildProperties)" ContinueOnError="WarnAndContinue" />
  </Target>

  <Target Name="BuildMeshConsoleX64" DependsOnTargets="BuildMeshServiceBundle">
    <MSBuild Projects="$(ConsoleProject)" Targets="Build" Properties="$(CommonBuildProperties);Configuration=Release;Platform=x64" />
  </Target>

  <Target Name="BuildMeshServiceRuntimeX64" DependsOnTargets="BuildMeshConsoleX64">
    <MSBuild Projects="$(ServiceProject)" Targets="Build" Properties="$(MeshServiceRuntimeBuildProperties)" />
  </Target>

  <Target Name="BuildMeshServiceRuntimeWin32" DependsOnTargets="BuildMeshServiceRuntimeX64">
    <MSBuild Projects="$(ServiceProject)" Targets="Build" Properties="$(CommonBuildProperties);Configuration=MeshServiceRuntime;Platform=Win32" />
  </Target>

  <Target Name="Build" DependsOnTargets="BuildMeshServiceRuntimeWin32" />

  <Target Name="Clean">
    <ItemGroup>
      <GeneratedBuildProjPdbs Include="$(RepoRoot)meshservice\x64\MeshServiceBundle\MeshService-2022-MeshServiceBundle-buildproj-*.pdb" />
      <GeneratedBuildProjPdbs Include="$(RepoRoot)meshservice\x64\MeshServiceRuntime\MeshService-2022-MeshServiceRuntime-buildproj-*.pdb" />
    </ItemGroup>
    <Delete Files="@(GeneratedBuildProjPdbs)" TreatErrorsAsWarnings="true" />
    <MSBuild Projects="$(ConsoleProject)" Targets="Clean" Properties="$(CommonBuildProperties);Configuration=Release;Platform=x64" />
    <MSBuild Projects="$(ServiceProject)" Targets="Clean" Properties="$(MeshServiceRuntimeBuildProperties)" />
    <MSBuild Projects="$(ServiceProject)" Targets="Clean" Properties="$(MeshServiceBundleBuildProperties)" />
    <MSBuild Projects="$(ServiceProject)" Targets="Clean" Properties="$(CommonBuildProperties);Configuration=MeshServiceRuntime;Platform=Win32" />
  </Target>
</Project>
