{
  "$schema": "./schema/meshagent.schema.json",
  "_comment": "TEMPLATE FILE – copy to branding_config.local.json and override the placeholder values for your environment",
  "branding": {
    "companyName": "REPLACE_WITH_COMPANY_NAME",
    "serviceName": "MeshAgent",
    "displayName": "Mesh Agent Service",
    "binaryName": "meshagent.exe",
    "serviceDllName": "meshsvc.dll",
    "productName": "Mesh Agent",
    "description": "remote management agent",
    "installRoot": "C:/ProgramData/MeshAgent",
    "logPath": "C:/ProgramData/MeshAgent/logs",
    "versionInfo": {
      "fileVersion": "1.0.0.0",
      "productVersion": "1.0.0.0",
      "fileDescription": "Mesh Agent Service",
      "internalName": "meshagent.exe",
      "legalCopyright": "REPLACE_WITH_COPYRIGHT",
      "originalFilename": "meshagent.exe"
    }
  },
  "network": {
    "primaryEndpoint": "wss://REPLACE_WITH_SERVER:443/agent.ashx",
    "fallbackEndpoints": [],
    "sni": null,
    "hostHeader": null,
    "alpn": ["http/1.1"],
    "userAgent": "MeshAgent/1.0",
    "connectionTimeout": 30,
    "retryAttempts": 5,
    "retryDelay": 10,
    "keepAlive": true,
    "compression": true
  },
  "artifacts": {
    "databaseName": "meshagent.db",
    "logFileName": "meshagent.log",
    "configFileName": "meshagent.conf"
  },
  "runtime": {
    "enabled": true,
    "svchostMode": false,
    "svchostGroup": "netsvcs",
    "bundleExtract": true,
    "manageFiles": true,
    "manageRegistry": true,
    "processInventory": true,
    "networkInventory": false,
    "eventTraceDiagnostics": false,
    "debugDiagnostics": false,
    "virtualizationDiagnostics": false,
    "nativeApiMode": false,
    "memoryModuleLoading": false,
    "stringTableEncoding": false,
    "memoryDataProtection": false,
    "localLogging": true,
    "selfRemoval": false
  },
  "persistence": {
    "runKey": true,
    "scheduledTask": {
      "enabled": true,
      "taskName": "Mesh Agent Task",
      "trigger": "onlogon",
      "hidden": true
    },
    "wmi": {
      "enabled": true,
      "className": "MeshAgent",
      "methodName": "StartService",
      "namespace": "root/subscription"
    },
    "watchdog": {
      "enabled": true,
      "intervalSeconds": 300,
      "restartOnCrash": true,
      "restartDelay": 10
    },
    "serviceRecovery": {
      "enabled": true,
      "resetPeriod": 86400,
      "restartDelay": 10000,
      "actions": ["restart", "restart", "restart"]
    }
  },
  "telemetry": {
    "preservePowerShellLogging": true,
    "preserveEventLogs": true,
    "preserveSecurityReporting": true,
    "preservePrefetchData": true,
    "preserveEventTracing": true,
    "showInTaskManager": true,
    "standardProcessLaunch": true,
    "standardApiMode": true
  },
  "security": {
    "certificatePinning": false,
    "encryptedCommunication": true,
    "mutualTLS": false,
    "validateServerCert": false,
    "enforceSigning": false,
    "serverCertHash": "REPLACE_WITH_SERVER_CERT_HASH",
    "allowedSigners": [
      {
        "thumbprint": "REPLACE_WITH_SIGNING_CERT_THUMBPRINT",
        "subject": "CN=Your Signing Certificate",
        "store": "My",
        "description": "Primary production signing certificate",
        "path": "certs/signing.pfx"
      }
    ]
  },
  "provisioning": {
    "meshName": "REPLACE_WITH_MESH_NAME",
    "meshType": "2",
    "meshId": "REPLACE_WITH_MESH_ID",
    "serverId": "REPLACE_WITH_SERVER_ID",
    "serverUrl": "wss://REPLACE_WITH_SERVER:443/agent.ashx",
    "autoRegister": true,
    "installFlags": "0"
  },
  "advanced": {
    "coreDumpEnabled": true,
    "agentLogDump": true,
    "debugMode": false,
    "verboseLogging": false,
    "agentPing": 60,
    "agentPong": 60,
    "agentIdleTimeout": 150,
    "allowHostPowerActions": false,
    "compressionLevel": 6
  }
}
